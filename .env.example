# Copia este archivo a .env y cambia TODOS los valores. .env no se sube a Git.
DB_NAME=inmobiliaria_db
DB_PASSWORD=cambia-esta-clave-del-master
DB_PASSWORD_REPLICA=cambia-esta-clave-de-la-replica
DB_REPLICATION_PASSWORD=cambia-esta-clave-de-replicacion
DB_PORT_MASTER=3306
DB_PORT_REPLICA=3307

# Solo para el perfil `app` (backend en Docker). Genera con: openssl rand -base64 48
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Solo desarrollo: crea admin@... y agente de ejemplo
SEED_DEMO_USERS=false
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=
