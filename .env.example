# Copia este archivo a .env y cambia TODOS los valores. .env no se sube a Git.
DB_NAME=inmobiliaria_db
DB_PASSWORD=cambia-esta-clave-del-master
DB_PASSWORD_REPLICA=cambia-esta-clave-de-la-replica
DB_REPLICATION_PASSWORD=cambia-esta-clave-de-replicacion
DB_PORT_MASTER=3306
DB_PORT_REPLICA=3307

# Solo para el perfil `app` (backend en Docker). Genera con: openssl rand -base64 48
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Solo desarrollo: crea admin@... y agente de ejemplo
SEED_DEMO_USERS=false
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# Monitoreo (Sesión 30). Genera con: openssl rand -hex 24  (o ejecuta ./scripts/monitoreo-preparar.sh)
MONITORING_TOKEN=
# Solo laboratorio: habilita POST /api/monitoreo/simular para provocar errores 500 o lentitud
MONITORING_SIMULATION=false
# Clave de Grafana (por defecto utp_admin, solo accesible desde 127.0.0.1)
GRAFANA_ADMIN_PASSWORD=utp_admin
# En producción deja solo la salud: MANAGEMENT_ENDPOINTS=health
MANAGEMENT_ENDPOINTS=health,prometheus

# Alta disponibilidad y respaldos automáticos (Sesión 32)
# Clave de cifrado AES-256 de los respaldos. Genera con: openssl rand -base64 32  y guárdala FUERA del servidor
# (sin ella no se puede restaurar). Nunca la subas a Git.
BACKUP_PASS=
# Almacén S3 de laboratorio (CloudServer). En producción usa un bucket real con Object Lock y credenciales propias.
S3_ACCESS_KEY=accessKey1
S3_SECRET_KEY=verySecretKey1
BACKUP_BUCKET=respaldos-inmobiliaria
# Retención WORM de cada respaldo (días) y periodo entre respaldos (86400 = diario; BACKUP_HORA_UTC=02:00 fija la hora)
BACKUP_RETENCION_DIAS=1
BACKUP_INTERVALO_SEGUNDOS=86400
BACKUP_HORA_UTC=
